{
  "Authentication": {
    "Composition": "DevelopmentJwt"
  },
  "ConnectionStrings": {
    "FinOpsDesk": "Server=(localdb)\\mssqllocaldb;Database=FinOpsDesk;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "FinOpsDesk.Api.Requests": "Information"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": false,
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ",
        "JsonWriterOptions": {
          "Indented": false
        }
      }
    }
  }
}
